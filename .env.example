# Copy this file to .env (same folder, repo root) and fill in real values for LOCAL development.
# .env is already in .gitignore — it will NEVER get committed/pushed to GitHub.
#
# On Railway, do NOT upload this file — instead set these same keys in:
#   Railway dashboard → your service → Variables tab → + New Variable
# Railway injects them as real environment variables at runtime.

# Required — get this from @BotFather on Telegram
BOT_TOKEN=

# Optional — only needed for /stats and /leaderboard to work.
# MongoDB connection string (Atlas, Railway's Mongo plugin, or your own VPS Mongo).
# Leave blank and the bot still runs fine, stats commands just say "no data yet".
MONGO_URI=

# Optional — database name used inside MongoDB. Defaults to "mafia_bot" if left blank.
MONGO_DB_NAME=
